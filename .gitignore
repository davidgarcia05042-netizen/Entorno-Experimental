venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env

# Pesos de modelos -- se descargan automáticamente (ultralytics/mediapipe),
# no deben vivir en git (binarios pesados, cientos de MB acumulados).
*.pt

# Datos del laboratorio (videos de pacientes reales + mocap) -- nunca subir
